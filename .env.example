# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# mock (default): zero API calls, zero cost, no key required - app.mock_llm.MockAnthropicClient.
# live: the real Anthropic client, real cost. Prefer overriding per-command (e.g.
# `make eval-fast-live`) over setting this to "live" here, so nothing runs live by accident.
APP_LLM_MODE=mock
# Hard caps for any single agent run
APP_MAX_STEPS=12
APP_MAX_COST_USD=0.50
# Set to 1 to disable trace logging
APP_TRACING_DISABLED=0
# Models (classifier is a cheap routing call; evaluator does web-search research)
APP_CLASSIFIER_MODEL=claude-haiku-4-5
APP_EVALUATOR_MODEL=claude-sonnet-5
# Max web searches per evaluator call
APP_MAX_SEARCHES=4
